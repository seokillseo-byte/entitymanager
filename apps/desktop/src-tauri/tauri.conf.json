{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EntityManager",
  "version": "0.1.0",
  "identifier": "com.entitymanager.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EntityManager",
        "width": 1440,
        "height": 920,
        "minWidth": 1180,
        "minHeight": 760
      },
      {
        "label": "browser-workspace",
        "title": "EntityManager — Browser Workspace",
        "url": "index.html",
        "visible": false,
        "width": 1500,
        "height": 920,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/extension/**/*", "resources/chromium/**/*", "resources/browser-worker/**/*"],
    "icon": ["icons/icon.ico"],
    "publisher": "EntityManager",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
